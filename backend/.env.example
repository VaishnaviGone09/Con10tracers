# CON10TRACERS Environment Variables

# Gemini API Key (optional - system works in demo mode without it)
GEMINI_API_KEY=

# Neo4j Configuration (optional - system works in demo mode without it)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# PostgreSQL Configuration (optional - system works in demo mode without it)
POSTGRES_URL=postgresql://user:password@localhost:5432/con10tracers

# Frontend Origin (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Social API Keys (optional - for future authorized integrations)
X_API_KEY=
INSTAGRAM_API_KEY=
TELEGRAM_API_KEY=
LINKEDIN_API_KEY=
FACEBOOK_API_KEY=

# Application Settings
DEBUG=True
DEMO_MODE=True
MONITORING_ENABLED=True
MONITORING_INTERVAL_MINUTES=30
